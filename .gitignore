# DSH analysis workspace — NOT part of the redistributable plugin.
# It contains reverse-engineering artifacts extracted from the proprietary Salt Player
# for Windows application and reference sources. NEVER publish this directory.
/work/

# Local debugging scratch (session dumps, decompiled API jars, ad-hoc harnesses).
# A previous baseline snapshot committed these by accident; they are never part of a release.
/.scratch/

# Third-party / generated build outputs
/node_modules/
**/node_modules/
**/.gradle/
**/.kotlin/
**/build/
packaging/web/
packaging/native/
packaging/out/
poc/webview/dist/
poc/webview/tools/
poc/webview/host/out/
poc/webview/host/build/
poc/webview/server/out/
poc/webview/shared/node_modules/
poc/audio/build/
poc/audio/measure/
poc/settings-ui/dist/
poc/settings-ui/public/thumbs/
research/settings-ui/
research/assets/
spw-folia/notes/

# Runtime test artifacts
*.log
*.shm
t4.shm
*.spmod
poc/hook/shots/*.png
poc/webview/server/out/
poc/webview/host/out/

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local agent state / release artifacts (the .spmod is attached to GitHub Releases, not committed)
/.dsh/
/dist/
/poc/hook/shots/

# Kotlin/JVM compile outputs and generated packaging audit files
poc/audio/out/
packaging/SHA256SUMS.txt
packaging/size-report.json

# hook acceptance evidence: screenshots stay local; docs/archive/acceptance-report.md records the results
poc/hook/acceptance/

# transient verification fixtures (poc/hook/verify-cover.mjs outputs)
/tmp-verify/
# staged bundle for the real-preview / verify-layout probes (scripts regenerate it)
/.tmp-verify/
# raw per-style captures used to rebuild poc/settings-ui/public/thumbs (scripts/make-thumbs.mjs)
/.tmp-thumbs/
# opening-splash acceptance run (scripts/verify-splash.mjs): screenshots + host logs
/.tmp-splash/
# colour-key / "no pink background" acceptance run (scripts/verify-colour-key.mjs)
/.tmp-colour-key/
# frame-rate acceptance run (scripts/verify-frame-rate.mjs): fps logs + webview profiles
/.tmp-frame-rate/

# local-only hook artifacts: installed-plugin backups and ad-hoc verification fixtures
poc/hook/backup/
poc/hook/tmp-verify/

# local verification scratch (screenshots, logs, probes output)
/tmp-inspect/
poc/webview/host/repro/*.exe
poc/webview/host/repro/*.dll
# compile output of the repro Java probes (VerifyResolver2 / RenameSim); the .java sources are tracked
poc/webview/host/repro/out/

# promo-site capture scratch (raw recordings, ffmpeg binary, screenshots)
/.tmp-capture/

# isolated Gradle home used by the local build (Aliyun-mirror workaround)
spw-folia/.gradle-home/

# Gradle/Kotlin build artifacts that the Baseline snapshot accidentally tracked
# (the tracked copies make every code review unreadable and they are regenerated anyway).
/spw-folia/build/
/spw-folia/.gradle/
